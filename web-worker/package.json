{
  "name": "@adocweave/wasm",
  "version": "0.54.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "AsciiDoc analysis and HTML rendering for browsers, powered by AdocWeave WebAssembly",
  "type": "module",
  "exports": {
    ".": {
      "types": "./worker/index.d.mts",
      "import": "./worker/index.mjs"
    },
    "./direct": {
      "types": "./worker/direct.d.mts",
      "import": "./worker/direct.mjs"
    }
  },
  "types": "./worker/index.d.mts",
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "THIRD_PARTY_NOTICES.adoc",
    "example",
    "wasm",
    "worker"
  ],
  "keywords": [
    "asciidoc",
    "browser",
    "webassembly",
    "web-worker"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/KeishiS/adocweave",
  "bugs": "https://github.com/KeishiS/adocweave/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeishiS/adocweave.git",
    "directory": "web-worker"
  },
  "scripts": {
    "test": "node --test worker.test.mjs release-manifest.test.mjs package-api.test.mjs direct.test.mjs",
    "test:cross-runtime": "node --test cross-runtime.test.mjs"
  }
}
