{
  "$defs": {
    "workspaceScanPattern": {
      "description": "ワークスペースルートを基準とする相対ディレクトリのパターン。区切りは`/`だけを使い、`*`と`?`は1階層、単独の`**`は複数階層に一致します。",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:\\*\\*|(?:[^/\\[\\]{}\\\\*\\x00-\\x1F\\x7F-\\x9F]|\\*(?!\\*))+)(?:/(?:\\*\\*|(?:[^/\\[\\]{}\\\\*\\x00-\\x1F\\x7F-\\x9F]|\\*(?!\\*))+))*$",
      "type": "string"
    }
  },
  "$id": "https://github.com/KeishiS/adocweave/config/adocweave.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "additionalProperties": false,
            "oneOf": [
              {
                "not": {
                  "required": [
                    "unset"
                  ]
                },
                "required": [
                  "value"
                ]
              },
              {
                "not": {
                  "required": [
                    "value"
                  ]
                },
                "required": [
                  "unset"
                ]
              }
            ],
            "properties": {
              "unset": {
                "const": true
              },
              "value": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "default": {},
          "type": "object"
        },
        "syntax-mode": {
          "default": "permissive",
          "enum": [
            "permissive",
            "strict"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "format": {
      "additionalProperties": false,
      "properties": {
        "final-newline": {
          "type": "boolean"
        },
        "max-consecutive-blank-lines": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "newline": {
          "enum": [
            "lf",
            "cr-lf"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "html": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "default": false,
          "type": "boolean"
        },
        "roles": {
          "default": [],
          "description": "HTMLへ`role-<name>` classとして出力するblock roleの名前。列挙していないroleは出力しません。",
          "items": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "stylesheet-files": {
          "default": [],
          "items": {
            "description": "プロジェクトディレクトリの内側を指す、`/`区切りの相対パス。",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
            "type": "string"
          },
          "type": "array"
        },
        "stylesheet-urls": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "lint": {
      "additionalProperties": false,
      "properties": {
        "max-consecutive-blank-lines": {
          "default": 2,
          "minimum": 1,
          "type": "integer"
        },
        "max-diagnostics": {
          "default": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "max-line-length": {
          "default": 100,
          "minimum": 1,
          "type": "integer"
        },
        "rules": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "information",
                  "hint"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "asciidoc-file-link",
              "attribute-expansion",
              "duplicate-anchor",
              "duplicate-heading-id",
              "excessive-blank-lines",
              "heading-marker-space",
              "inconsistent-list",
              "invalid-anchor",
              "invalid-attribute",
              "invalid-catalog",
              "invalid-cross-reference",
              "invalid-document-structure",
              "invalid-heading-level",
              "invalid-list-presentation",
              "invalid-stem",
              "invalid-table",
              "invalid-url-scheme",
              "line-too-long",
              "macro-boundary",
              "missing-source-language",
              "monospace-boundary",
              "nesting-limit-exceeded",
              "non-asciidoc-xref",
              "protected-attribute",
              "trailing-whitespace",
              "unclosed-block",
              "unclosed-inline",
              "undefined-attribute",
              "unprocessed-directive",
              "unresolved-cross-reference",
              "unused-attribute"
            ]
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "local-targets": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "project-root"
            ]
          }
        }
      ],
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "project-root": {
          "description": "プロジェクトディレクトリの内側を指す、`/`区切りの相対パス。",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "include": {
          "default": true,
          "type": "boolean"
        },
        "max-files": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "max-resource-bytes": {
          "default": 10485760,
          "maximum": 10485760,
          "minimum": 1,
          "type": "integer"
        },
        "max-total-bytes": {
          "default": 52428800,
          "maximum": 52428800,
          "minimum": 1,
          "type": "integer"
        },
        "roots": {
          "default": [],
          "items": {
            "description": "プロジェクトディレクトリの内側を指す、`/`区切りの相対パス。",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "schema-version": {
      "const": 1,
      "type": "integer"
    },
    "workspace": {
      "additionalProperties": false,
      "properties": {
        "scan": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "default": [
                "**/.git",
                "**/.venv",
                "**/node_modules",
                "**/target"
              ],
              "items": {
                "$ref": "#/$defs/workspaceScanPattern"
              },
              "maxItems": 256,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema-version"
  ],
  "title": "AdocWeave project configuration",
  "type": "object"
}
