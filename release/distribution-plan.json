{
  "schemaVersion": 3,
  "distVersion": "0.31.0",
  "repository": "https://github.com/KeishiS/adocweave",
  "products": [
    {
      "product": "cli",
      "versionSource": "crates/adocweave-cli/Cargo.toml#package.version",
      "tagPrefix": "adocweave-cli/v",
      "assetKind": "cli",
      "assetName": "adocweave-cli-{target}.zip",
      "archive": "zip",
      "executable": "adocweave{executableSuffix}",
      "build": "cargo-dist",
      "package": "adocweave-cli"
    },
    {
      "product": "lsp",
      "versionSource": "crates/adocweave-lsp/Cargo.toml#package.version",
      "tagPrefix": "adocweave-lsp/v",
      "assetKind": "lsp",
      "assetName": "adocweave-lsp-{target}.zip",
      "archive": "zip",
      "executable": "adocweave-lsp{executableSuffix}",
      "build": "cargo-dist",
      "package": "adocweave-lsp"
    },
    {
      "product": "browser",
      "versionSource": "web-worker/package.json#version",
      "tagPrefix": "adocweave-browser/v",
      "assetKind": "browser",
      "assetName": "adocweave-browser-{version}.tgz",
      "archive": "tgz",
      "executable": null,
      "build": "script",
      "buildScript": "tools/package-browser-release.sh"
    },
    {
      "product": "textlint",
      "versionSource": "packages/textlint-plugin-asciidoc/package.json#version",
      "tagPrefix": "adocweave-textlint/v",
      "assetKind": "textlint-plugin",
      "assetName": "adocweave-textlint-plugin-asciidoc-{version}.tgz",
      "archive": "tgz",
      "executable": null,
      "build": "script",
      "buildScript": "tools/package-textlint-plugin-release.sh"
    },
    {
      "product": "vscode",
      "versionSource": "editors/vscode/package.json#version",
      "tagPrefix": "adocweave-vscode/v",
      "assetKind": "vscode",
      "assetName": "adocweave-vscode-{version}.vsix",
      "archive": "vsix",
      "executable": null,
      "build": "script",
      "buildScript": "tools/package-vscode-release.sh"
    },
    {
      "product": "zed",
      "versionSource": "editors/zed/extension.toml#version",
      "tagPrefix": "adocweave-zed/v",
      "assetKind": "zed",
      "assetName": "adocweave-zed-{version}.tar.xz",
      "archive": "tar.xz",
      "executable": null,
      "build": "script",
      "buildScript": "tools/package-zed-release.sh"
    }
  ],
  "targets": [
    {
      "archive": "zip",
      "architecture": "arm64",
      "executableSuffix": "",
      "linkage": "static",
      "minimumOsVersion": null,
      "os": "linux",
      "runner": "ubuntu-24.04-arm",
      "triple": "aarch64-unknown-linux-musl"
    },
    {
      "archive": "zip",
      "architecture": "arm64",
      "executableSuffix": "",
      "linkage": "system",
      "minimumOsVersion": "14.0",
      "os": "darwin",
      "runner": "macos-15",
      "triple": "aarch64-apple-darwin"
    },
    {
      "archive": "zip",
      "architecture": "x64",
      "executableSuffix": "",
      "linkage": "static",
      "minimumOsVersion": null,
      "os": "linux",
      "runner": "ubuntu-24.04",
      "triple": "x86_64-unknown-linux-musl"
    },
    {
      "archive": "zip",
      "architecture": "x64",
      "executableSuffix": ".exe",
      "linkage": "system",
      "minimumOsVersion": "10.0.17763",
      "os": "win32",
      "runner": "windows-2025",
      "triple": "x86_64-pc-windows-msvc"
    }
  ],
  "releaseMetadata": [
    {
      "name": "adocweave-dist-manifest.json",
      "kind": "distribution-manifest",
      "format": "canonical-json"
    },
    {
      "name": "sha256.sum",
      "kind": "checksums",
      "format": "sha256"
    }
  ]
}
