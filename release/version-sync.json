{
  "schemaVersion": 1,
  "literals": [
    {
      "path": "CHANGELOG.md",
      "template": "[{version}]",
      "count": 2
    }
  ],
  "cargoLocks": [
    {
      "path": "Cargo.lock",
      "packages": [
        "adocweave",
        "adocweave-cli",
        "adocweave-config",
        "adocweave-host",
        "adocweave-lsp",
        "adocweave-project",
        "adocweave-textlint",
        "adocweave-wasm",
        "adocweave-workspace"
      ]
    },
    {
      "path": "fuzz/Cargo.lock",
      "packages": ["adocweave"]
    }
  ]
}
