{
  "schemaVersion": 1,
  "literals": [
    {
      "path": "web-worker/package.json",
      "template": "\"version\": \"{version}\"",
      "count": 1
    },
    {
      "path": "web-worker/contracts.mjs",
      "template": "export const WASM_PACKAGE_VERSION = \"{version}\";",
      "count": 1
    },
    {
      "path": "packages/textlint-plugin-asciidoc/package.json",
      "template": "\"version\": \"{version}\"",
      "count": 1
    },
    {
      "path": "editors/vscode/package.json",
      "template": "\"version\": \"{version}\"",
      "count": 1
    },
    {
      "path": "editors/vscode/package-lock.json",
      "template": "\"version\": \"{version}\"",
      "count": 2
    },
    {
      "path": "editors/zed/Cargo.toml",
      "template": "version = \"{version}\"",
      "count": 1
    },
    {
      "path": "editors/zed/extension.toml",
      "template": "version = \"{version}\"",
      "count": 1
    },
    {
      "path": "CHANGELOG.md",
      "template": "[{version}]",
      "count": 2
    },
    {
      "path": "dist-workspace.toml",
      "template": "-{version}",
      "count": 4
    }
  ],
  "cargoLocks": [
    {
      "path": "Cargo.lock",
      "packages": [
        "adocweave",
        "adocweave-cli",
        "adocweave-config",
        "adocweave-host",
        "adocweave-lsp",
        "adocweave-project",
        "adocweave-textlint",
        "adocweave-wasm",
        "adocweave-workspace"
      ]
    },
    {
      "path": "fuzz/Cargo.lock",
      "packages": ["adocweave"]
    },
    {
      "path": "editors/zed/Cargo.lock",
      "packages": ["adocweave-zed"]
    }
  ]
}
