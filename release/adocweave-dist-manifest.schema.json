{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeishiS/adocweave/blob/main/release/adocweave-dist-manifest.schema.json",
  "title": "AdocWeave product distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "productVersion",
    "sourceCommit",
    "assets"
  ],
  "properties": {
    "schemaVersion": { "const": 5 },
    "product": { "enum": ["cli", "lsp", "wasm", "textlint", "vscode", "zed"] },
    "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        }
      }
    }
  }
}
