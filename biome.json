{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.json",
      "editors/vscode/**/*.{ts,mts}",
      "!config/adocweave.schema.json",
      "!**/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  }
}
