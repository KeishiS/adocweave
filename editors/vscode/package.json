{
  "name": "adocweave-vscode",
  "displayName": "AdocWeave",
  "description": "AdocWeave Language Server client and AsciiDoc syntax highlighting",
  "version": "0.46.2",
  "publisher": "adocweave",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/KeishiS/adocweave",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeishiS/adocweave.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "asciidoc",
    "adoc",
    "language-server"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:asciidoc"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "adocweave.restartServer",
        "title": "AdocWeave: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "AdocWeave",
      "properties": {
        "adocweave.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the adocweave-lsp executable to use. When empty, the extension searches PATH."
        }
      }
    },
    "languages": [
      {
        "id": "asciidoc",
        "aliases": [
          "AsciiDoc",
          "asciidoc"
        ],
        "extensions": [
          ".adoc",
          ".asciidoc",
          ".asc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asciidoc",
        "scopeName": "text.asciidoc",
        "path": "./syntaxes/asciidoc.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "check": "npm run format:check && npm run lint && tsc --noEmit && tsc -p tsconfig.scripts.json && node scripts/validate-package.mts",
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts",
    "lint": "biome lint src test scripts",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "build:test": "node scripts/build-test.mts",
    "package": "node scripts/package.mts",
    "test:vsix-installation": "node scripts/vsix-installation-smoke.mts",
    "test:extension": "node scripts/run-extension-tests.mts"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
