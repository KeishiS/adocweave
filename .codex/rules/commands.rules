prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Web Workerのテストを許可する"
)

prefix_rule(
    pattern = ["npm", "run", "test:cross-runtime"],
    decision = "allow",
    justification = "Web Workerのテストを許可する"
)

prefix_rule(
    pattern = ["adocweave-fuzz", "check"],
    decision = "allow",
    justification = "fuzz targetの構成検査を許可する"
)

prefix_rule(
    pattern = ["nix", "develop", ".#ci", "-c", ["cargo", "npm"]],
    decision = "allow",
    justification = "CI用Nix環境内でRustとnpmの検証を許可する",
    match = [
        "nix develop .#ci -c cargo make verify",
        "nix develop .#ci -c npm test",
    ],
    not_match = [
        "nix develop .#ci -c gh issue create --title '題名です' --body '本文です。'",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "comment", "review"]],
    decision = "forbidden",
    justification = "文章を投稿するときは`node tools/checked-gh-prose.mjs`を使用する",
    match = [
        "gh pr create --title '題名です' --body '本文です。'",
        "gh pr comment 710 --body '本文です。'",
    ],
    not_match = [
        "gh pr view 710",
        "gh pr checks 710",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", ["create", "edit", "comment"]],
    decision = "forbidden",
    justification = "文章を投稿するときは`node tools/checked-gh-prose.mjs`を使用する",
    match = [
        "gh issue create --title '題名です' --body '本文です。'",
        "gh issue comment 683 --body '本文です。'",
    ],
    not_match = [
        "gh issue view 683",
    ],
)

prefix_rule(
    pattern = ["node", "tools/checked-gh-prose.mjs"],
    decision = "allow",
    justification = "禁止語を検査してからGitHubへ文章を投稿する",
    match = [
        "node tools/checked-gh-prose.mjs issue create --title '題名です' --body '本文です。'",
        "node tools/checked-gh-prose.mjs pr comment 710 --body '本文です。'",
    ],
    not_match = [
        "node tools/textlint/github-markdown-lint.mjs body /tmp/body.md",
    ],
)

prefix_rule(
    pattern = [
        "git",
        ["add", "branch", "commit", "merge", "push", "rebase", "tag", "worktree"],
    ],
    decision = "allow",
    justification = "Gitの状態または外部remoteへ影響する操作を許可する",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "作業内容を失うため禁止する。必要な変更は個別のpatchで行う",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡ファイルを失う可能性があるため禁止する。対象を確認して個別に処理する",
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "未commit変更を失う可能性があるため禁止する。個別のpatchで復元する",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "再帰的な強制削除は禁止する。対象を確認して個別に削除する",
)
